{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-probe-status",
    "allow-start-task",
    "allow-respond-permission",
    "allow-stop-session",
    "allow-open-desktop-app",
    "allow-load-local-store",
    "allow-save-local-store",
    "allow-create-local-project",
    "allow-create-local-session",
    "dialog:allow-open"
  ]
}
