{
  "default": {
    "description": "Main-window commands used by the GUI",
    "permissions": [
      "allow-probe-status",
      "allow-start-task",
      "allow-respond-permission",
      "allow-stop-session",
      "allow-open-desktop-app",
      "allow-load-local-store",
      "allow-save-local-store",
      "allow-create-local-project",
      "allow-create-local-session"
    ]
  },
  "permission": [
    {
      "identifier": "allow-probe-status",
      "description": "Allows probing grok/agy CLI and installed desktop apps",
      "commands": { "allow": ["probe_status"] }
    },
    {
      "identifier": "allow-start-task",
      "description": "Allows spawning one official CLI session",
      "commands": { "allow": ["start_task"] }
    },
    {
      "identifier": "allow-respond-permission",
      "description": "Allows sending a single-shot permission decision",
      "commands": { "allow": ["respond_permission"] }
    },
    {
      "identifier": "allow-stop-session",
      "description": "Allows stopping the active CLI session",
      "commands": { "allow": ["stop_session"] }
    },
    {
      "identifier": "allow-open-desktop-app",
      "description": "Allows opening an already-installed KayG or Antigravity desktop app via macOS open",
      "commands": { "allow": ["open_desktop_app"] }
    },
    {
      "identifier": "allow-load-local-store",
      "description": "Allows reading the local projects-sessions JSON from app data",
      "commands": { "allow": ["load_local_store"] }
    },
    {
      "identifier": "allow-save-local-store",
      "description": "Allows writing the local projects-sessions JSON to app data",
      "commands": { "allow": ["save_local_store"] }
    },
    {
      "identifier": "allow-create-local-project",
      "description": "Allows creating a local project bound to an existing workspace directory",
      "commands": { "allow": ["create_local_project"] }
    },
    {
      "identifier": "allow-create-local-session",
      "description": "Allows creating a chat session bound to a local project",
      "commands": { "allow": ["create_local_session"] }
    }
  ]
}
